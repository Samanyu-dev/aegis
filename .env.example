# =========================================================================
# AEGIS — ENVIRONMENT VARIABLE PARAMETERS
# =========================================================================

# 1. BRIGHT DATA INTEGRATION
# Get Serp key, Web Unlocker URL, and Scraping Browser CDP link from brightdata.com
BRIGHT_DATA_SERP_API_KEY=
BRIGHT_DATA_WEB_UNLOCKER_URL=
BRIGHT_DATA_SCRAPING_BROWSER_URL=

# 2. AI/ML API CONFIGURATION
# Claim your coupon on lablab.ai event dashboard first
AIML_API_KEY=
AIML_API_BASE_URL=https://api.aimlapi.com/v1

# 3. COGNEE PERSISTENT MEMORY GRAPH
# Grab key from your cognee.ai profile page
COGNEE_API_KEY=

# 4. TRIGGERWARE EVENT-DRIVEN WORKFLOWS
# Setup an inbound webhook flow in app.triggerware.ai and paste webhook URL
TRIGGERWARE_WEBHOOK_URL=

# 5. TELEMETRY & DATABASES
# PostgreSQL connection string (defaults to local SQLite 'aegis.db' if left empty)
DATABASE_URL=

# Port/Host specs
NEXT_PUBLIC_API_URL=http://localhost:8000
